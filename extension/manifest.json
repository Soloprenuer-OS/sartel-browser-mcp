{
  "manifest_version": 3,
  "name": "Sartel",
  "version": "1.0.0",
  "description": "Let your local Sartel agent drive your own logged-in Chrome: navigate, click, fill forms, read pages, screenshot. All on 127.0.0.1.",
  "key": "",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "tabs",
    "tabGroups",
    "cookies",
    "scripting",
    "activeTab",
    "storage",
    "alarms",
    "offscreen",
    "notifications",
    "webNavigation",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  }
}
